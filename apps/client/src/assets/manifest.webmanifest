{
    "name": "Helium-III",
    "short_name": "Helium-III",
    "description": "Helium-III is a hierarchical note taking application for large personal knowledge bases, a fork of TriliumNext.",
    "theme_color": "#1a1922",
    "background_color": "#1a1922",
    "display": "standalone",
    "scope": "/",
    "start_url": "/",
    "display_override": [
        "window-controls-overlay"
    ],
    "icons": [
        {
            "src": "icon.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "share_target": {
        "action": "share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": ["*/*"]
                }
            ]
        }
    }
}
